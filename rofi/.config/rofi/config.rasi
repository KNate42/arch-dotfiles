configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "Inter 12";
    display-drun: "";
    display-run: "";
    display-window: "";
    drun-display-format: "{name}";
}

@theme "theme.rasi"
