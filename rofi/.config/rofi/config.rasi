/* rofi launcher config */
/* This work made by Anfinogentov Nikita */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font 11";
    display-drun: "󰀻  Приложения";
    display-run: "󰆍  Команды";
    display-window: "󰖳  Окна";
    drun-display-format: "{name}";
}

@theme "theme.rasi"
