/* rofi look: wallpaper panel on the left, search and apps on the right; colors from colors.rasi (matugen) */
/* This work made by Anfinogentov Nikita */

* {
    bg: #111318d9;
    bg-alt: #282a2fb3;
    fg: #e2e2e9;
    fg-alt: #c4c6d0;
    accent: #aac7ff;
    accent-2: #e3bada;
    accent-soft: #aac7ff2e;
    on-accent: #0a305f;
    border-col: #44474e59;
    wallpaper: linear-gradient(135deg, #3a5ba0, #8a4fbf);
    accent-gradient: linear-gradient(to right, #aac7ff, #e3bada);
}

/* Здесь я подключаю палитру и обои matugen поверх запасных значений выше */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 820px;
    border: 1px;
    border-color: @border-col;
    border-radius: 26px;
    background-color: @bg;
    padding: 10px;
}

mainbox {
    orientation: horizontal;
    spacing: 14px;
    children: [ imagebox, listbox ];
}

/* Слева — текущие обои: лаунчер меняется вместе с темой */
imagebox {
    expand: false;
    width: 280px;
    border-radius: 18px;
    background-image: @wallpaper;
    orientation: vertical;
    padding: 18px;
    children: [ textbox-greeting, dummy, mode-switcher ];
}

textbox-greeting {
    expand: false;
    str: "Что запустим?";
    font: "Inter Bold 20";
    text-color: #ffffff;
}

mode-switcher {
    orientation: vertical;
    spacing: 6px;
}

button {
    padding: 10px 14px;
    border-radius: 14px;
    background-color: #00000059;
    text-color: #ffffffcc;
    font: "Inter SemiBold 11";
    horizontal-align: 0;
}

button selected {
    background-color: #ffffffe6;
    text-color: #111318;
}

listbox {
    orientation: vertical;
    spacing: 12px;
    padding: 8px 8px 8px 0px;
    children: [ inputbar, listview ];
}

/* Поле поиска-пилюля */
inputbar {
    padding: 12px 18px;
    border-radius: 24px;
    background-color: @bg-alt;
    children: [ textbox-search, entry ];
    spacing: 12px;
}

textbox-search {
    expand: false;
    str: "󰍉";
    font: "JetBrainsMono Nerd Font 14";
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Поиск приложений…";
    placeholder-color: @fg-alt;
    text-color: @fg;
    vertical-align: 0.5;
    font: "Inter 13";
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 9px 12px;
    border-radius: 16px;
    spacing: 14px;
}

/* Здесь я заливаю выбранную строку переливом из двух цветов обоев */
element selected {
    background-image: @accent-gradient;
    text-color: @on-accent;
}

element-icon {
    size: 34px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    font: "Inter Medium 12";
}
