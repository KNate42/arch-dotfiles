/* rofi look (cyberpunk HUD): wallpaper panel on the left, search and apps on the right; colors from colors.rasi (matugen) */
/* This work made by Anfinogentov Nikita */

* {
    bg: #05040ae6;
    bg-alt: #0c0b16f2;
    fg: #e8f7ff;
    fg-alt: #6f8fa0;
    accent: #00e5ff;
    accent-2: #ff2bd6;
    accent-soft: #00e5ff26;
    on-accent: #02121a;
    border-col: #00e5ffaa;
    wallpaper: linear-gradient(135deg, #3a5ba0, #8a4fbf);
    accent-gradient: linear-gradient(to right, #aac7ff, #e3bada);
}

/* Здесь я подключаю палитру и обои matugen поверх запасных значений выше */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 820px;
    border: 1px;
    border-color: @border-col;
    border-radius: 0px;
    background-color: @bg;
    padding: 10px;
}

mainbox {
    orientation: horizontal;
    spacing: 14px;
    children: [ imagebox, listbox ];
}

/* Слева — текущие обои: лаунчер меняется вместе с темой */
imagebox {
    expand: false;
    width: 280px;
    border-radius: 0px;
    background-image: @wallpaper;
    orientation: vertical;
    padding: 18px;
    children: [ textbox-greeting, dummy, mode-switcher ];
}

textbox-greeting {
    expand: false;
    str: ">> LAUNCH_";
    font: "JetBrainsMono Nerd Font Bold 20";
    text-color: #00e5ff;
}

mode-switcher {
    orientation: vertical;
    spacing: 6px;
}

button {
    padding: 10px 14px;
    border-radius: 0px;
    background-color: #05040acc;
    text-color: #00e5ff;
    border: 1px;
    border-color: #00e5ff88;
    font: "JetBrainsMono Nerd Font Bold 10";
    horizontal-align: 0;
}

button selected {
    background-color: #ff2bd6;
    text-color: #05040a;
}

listbox {
    orientation: vertical;
    spacing: 12px;
    padding: 8px 8px 8px 0px;
    children: [ inputbar, listview ];
}

/* Поле поиска: строка ввода терминала с неоновой нижней чертой */
inputbar {
    padding: 12px 18px;
    border: 0px 0px 2px 0px;
    border-color: @accent;
    border-radius: 0px;
    background-color: @bg-alt;
    children: [ textbox-search, entry ];
    spacing: 12px;
}

textbox-search {
    expand: false;
    str: "󰍉";
    font: "JetBrainsMono Nerd Font 14";
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "поиск_";
    placeholder-color: @fg-alt;
    text-color: @fg;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 12";
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 9px 12px;
    border-radius: 0px;
    spacing: 14px;
}

/* Здесь я заливаю выбранную строку переливом из двух цветов обоев */
element selected {
    background-color: @accent;
    text-color: @on-accent;
    border: 0px 0px 0px 4px;
    border-color: @accent-2;
}

element-icon {
    size: 34px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font Medium 11";
}
