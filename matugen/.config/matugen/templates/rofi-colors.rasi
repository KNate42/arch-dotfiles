/* rofi colors for the cyberpunk HUD: fixed neon; matugen gives only the current wallpaper path */
/* This work made by Anfinogentov Nikita */

* {
    bg: #05040ae6;
    bg-alt: #0c0b16f2;
    fg: #e8f7ff;
    fg-alt: #6f8fa0;
    accent: #00e5ff;
    accent-2: #ff2bd6;
    accent-soft: #00e5ff26;
    on-accent: #02121a;
    border-col: #00e5ffaa;
    wallpaper: url("{{image}}", height);
    accent-gradient: linear-gradient(to right, #00e5ff, #ff2bd6);
}
