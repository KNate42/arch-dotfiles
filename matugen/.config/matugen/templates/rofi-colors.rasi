/* rofi colors, generated by matugen from the current wallpaper */
/* This work made by Anfinogentov Nikita */

* {
    /* Полупрозрачные поверхности под размытие Hyprland, акценты и сами обои для боковой панели */
    bg: {{colors.surface.default.hex}}d9;
    bg-alt: {{colors.surface_container_high.default.hex}}b3;
    fg: {{colors.on_surface.default.hex}};
    fg-alt: {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    accent-2: {{colors.tertiary.default.hex}};
    accent-soft: {{colors.primary.default.hex}}2e;
    on-accent: {{colors.on_primary.default.hex}};
    border-col: {{colors.outline_variant.default.hex}}59;
    wallpaper: url("{{image}}", height);
    accent-gradient: linear-gradient(to right, {{colors.primary.default.hex}}, {{colors.tertiary.default.hex}});
}
